# Full path to the music library root directory
# Example: F:\MP3
MUSIC_LIBRARY_ROOT=

# Spotify API credentials (get from https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Cloudflare R2 – album art storage (get from R2 dashboard → Manage R2 API tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=<bucket-name>

# Set this to serve album art from R2 instead of local /album-art/
# Leave empty for local dev (falls back to /album-art/)
ALBUM_ART_BASE_URL=

# Last.fm API credentials (get from https://www.last.fm/api/account/create)
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=