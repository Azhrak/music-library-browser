---
import Layout from '../components/astro/Layout.astro';
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <div class="flex flex-col items-center justify-center py-24 text-center">
    <p class="text-8xl font-bold text-accent opacity-40">404</p>
    <h1 class="mt-4 text-2xl font-bold text-gray-100">Page not found</h1>
    <p class="mt-2 text-gray-400">The page you're looking for doesn't exist.</p>
    <a href="/" class="mt-6 rounded-md bg-accent px-4 py-2 text-sm font-medium text-white hover:bg-accent/80 transition-colors">
      Back to Music Library
    </a>
  </div>
</Layout>
