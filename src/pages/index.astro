---
import Layout from '../components/astro/Layout.astro';
import GenreList from '../components/react/GenreList';
import { getLibrary, getGenreCounts } from '../lib/musicData';
import { getArtistPlaycount } from '../lib/lastfm';
import { Users, Album, Music } from '@lucide/astro';
import type { Genre, Subgenre, Artist } from '../../scripts/types';

const library = getLibrary();
const stats = library.stats;

function sumArtistPlays(artists: Artist[]): number {
  let total = 0;
  for (const a of artists) total += getArtistPlaycount(a.slug) ?? 0;
  return total;
}

function getGenrePlaycount(node: Genre | Subgenre): number {
  let total = sumArtistPlays(node.artists);
  for (const child of node.subgenres) total += getGenrePlaycount(child);
  return total;
}

const genreRows = library.genres.map((g) => {
  const counts = getGenreCounts(g);
  return {
    name: g.name,
    href: `/genre/${g.slug}`,
    artistCount: counts.artists,
    albumCount: counts.albums,
    subgenreCount: g.subgenres.length,
    plays: getGenrePlaycount(g),
  };
});

const hasPlaycounts = genreRows.some((g) => g.plays > 0);
---

<Layout
  title="Music Library"
  description={`A personal music library browser — ${stats.totalArtists.toLocaleString()} artists and ${stats.totalAlbums.toLocaleString()} albums across ${stats.totalGenres} genres.`}
>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Music Library",
    "url": "https://music-library.azhrak.dev",
    "description": `A personal music library browser — ${stats.totalArtists} artists and ${stats.totalAlbums} albums across ${stats.totalGenres} genres.`,
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://music-library.azhrak.dev/?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  })} />
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-100">Music Library</h1>
    <div class="mt-4 flex flex-wrap gap-6 text-gray-400">
      <div class="flex items-center gap-2">
        <Users class="h-5 w-5 text-accent" />
        <span>{stats.totalArtists.toLocaleString()} artists</span>
      </div>
      <div class="flex items-center gap-2">
        <Album class="h-5 w-5 text-accent" />
        <span>{stats.totalAlbums.toLocaleString()} albums</span>
      </div>
      <div class="flex items-center gap-2">
        <Music class="h-5 w-5 text-accent" />
        <span>{stats.totalGenres} genres</span>
      </div>
    </div>
  </div>

  <GenreList genres={genreRows} hasPlaycounts={hasPlaycounts} client:load />
</Layout>
